# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps API Key for interactive corridor mapping and GIS tracking (Frontend)
VITE_GOOGLE_MAPS_API_KEY=

# Google Routes API Key for computing optimal paths (Backend)
GOOGLE_ROUTES_API_KEY=

# Featherless LLM API Key for AI Explanations and Briefings (Backend)
FEATHERLESS_API_KEY=

# Providers Configuration
LLM_PROVIDER="featherless"
ROUTES_PROVIDER="google"

# Admin Token for secured backend endpoints
ADMIN_TOKEN="super-secret-admin-token-change-me"
